{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/coworld/main/src/coworld/coworld_manifest_schema.json",
  "tags": [
    "social-deduction",
    "real-time",
    "multiplayer"
  ],
  "game": {
    "name": "crewrift_prime",
    "version": "0.4.74",
    "description": "Crewrift Prime \u2014 a forked social-deduction Crewrift coworld seeded for skill-tested play, with config-only scenario-parameterization variants (hunting, voting, task-pressure drills) per the parameterized-coworlds research. Derived league display name: \"Crewrift Prime\".",
    "owner": "treeform@softmax.com",
    "config_schema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "tokens",
        "players"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "default": -1,
          "minimum": -1,
          "description": "Random seed. Use -1 to pick a time-based seed."
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "crew",
                  "imposter"
                ],
                "type": "string"
              },
              "color": {
                "enum": [
                  "red",
                  "blue",
                  "green",
                  "pink",
                  "orange",
                  "yellow",
                  "purple",
                  "cyan",
                  "lime",
                  "brown",
                  "beige",
                  "navy",
                  "teal",
                  "rose",
                  "maroon",
                  "gray"
                ],
                "type": "string"
              },
              "token": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "default": [],
          "maxItems": 16,
          "description": "Optional fixed player slot role, color, and token settings."
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 16,
          "minItems": 8,
          "description": "One connection token per player slot, indexed by slot."
        },
        "mapPath": {
          "type": "string",
          "default": "data/croatoan.resources",
          "description": "Resource map file path."
        },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "maxItems": 16,
          "minItems": 8,
          "description": "One player display-name object per player slot, indexed by slot."
        },
        "fastMode": {
          "type": "boolean",
          "default": true,
          "description": "Advance frames early when all players report ready."
        },
        "maxGames": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Maximum games before shutdown."
        },
        "maxTicks": {
          "type": "integer",
          "default": 10000,
          "minimum": 0,
          "description": "Maximum task-phase game ticks, where 0 means no limit."
        },
        "killRange": {
          "type": "integer",
          "default": 20,
          "minimum": 0,
          "description": "Kill interaction range."
        },
        "ventRange": {
          "type": "integer",
          "default": 16,
          "minimum": 0,
          "description": "Vent interaction range."
        },
        "minPlayers": {
          "type": "integer",
          "default": 8,
          "maximum": 16,
          "minimum": 1,
          "description": "Players needed before the game countdown starts."
        },
        "buttonCalls": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "description": "Emergency button calls allowed per player."
        },
        "reportRange": {
          "type": "integer",
          "default": 20,
          "minimum": 0,
          "description": "Body report interaction range."
        },
        "closedRoster": {
          "type": "boolean",
          "default": false,
          "description": "Reject players outside the configured token/slot roster."
        },
        "gameOverTicks": {
          "type": "integer",
          "default": 360,
          "minimum": 0,
          "description": "Game over display duration in ticks."
        },
        "imposterCount": {
          "type": "integer",
          "default": 2,
          "maximum": 15,
          "minimum": 0,
          "description": "Fixed imposter count when autoImposterCount is false."
        },
        "showTaskArrows": {
          "type": "boolean",
          "default": true,
          "description": "Show arrows pointing to tasks."
        },
        "startWaitTicks": {
          "type": "integer",
          "default": 120,
          "minimum": 0,
          "description": "Lobby countdown ticks after enough players join."
        },
        "tasksPerPlayer": {
          "type": "integer",
          "default": 8,
          "minimum": 0,
          "description": "Tasks assigned to each crewmate."
        },
        "voteTimerTicks": {
          "type": "integer",
          "default": 7200,
          "minimum": 1,
          "description": "Voting phase duration in ticks."
        },
        "roleRevealTicks": {
          "type": "integer",
          "default": 120,
          "minimum": 0,
          "description": "Role reveal duration in ticks."
        },
        "showTaskBubbles": {
          "type": "boolean",
          "default": true,
          "description": "Show task bubbles."
        },
        "voteResultTicks": {
          "type": "integer",
          "default": 72,
          "minimum": 0,
          "description": "Vote result display duration in ticks."
        },
        "showPlayerLabels": {
          "type": "boolean",
          "default": true,
          "description": "Show policy display names above visible characters in spectator and player views."
        },
        "autoImposterCount": {
          "type": "boolean",
          "default": false,
          "description": "Automatically choose imposter count from player count."
        },
        "killCooldownTicks": {
          "type": "integer",
          "default": 800,
          "minimum": 0,
          "description": "Kill cooldown duration in ticks."
        },
        "taskCompleteTicks": {
          "type": "integer",
          "default": 72,
          "minimum": 0,
          "description": "Task completion duration in ticks."
        },
        "connectTimeoutTicks": {
          "type": "integer",
          "default": 2880,
          "minimum": 0,
          "description": "Initial connection grace duration in ticks."
        },
        "messageCooldownTicks": {
          "type": "integer",
          "default": 100,
          "minimum": 0,
          "description": "Chat message cooldown in ticks."
        },
        "disconnectTimeoutTicks": {
          "type": "integer",
          "default": 720,
          "minimum": 0,
          "description": "Reconnect grace duration in ticks."
        },
        "buttonResetsKillCooldowns": {
          "type": "boolean",
          "default": false,
          "description": "Whether emergency button meetings reset kill cooldowns."
        }
      },
      "additionalProperties": false
    },
    "results_schema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "scores"
      ],
      "properties": {
        "win": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One win flag per player slot."
        },
        "crew": {
          "type": "array",
          "items": {
            "type": "integer",
            "maximum": 1,
            "minimum": 0
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One 1 or 0 flag for whether the player was crew."
        },
        "kills": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One kill count per player slot."
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One player name or address per player slot."
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One completed task count per player slot."
        },
        "scores": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One scalar score per player slot."
        },
        "imposter": {
          "type": "array",
          "items": {
            "type": "integer",
            "maximum": 1,
            "minimum": 0
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One 1 or 0 flag for whether the player was an imposter."
        },
        "vote_skip": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One count of explicit skip votes per player slot."
        },
        "vote_players": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One count of votes cast for a player per player slot."
        },
        "vote_timeout": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One count of vote timeouts per player slot."
        },
        "connect_timeout": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One count of initial connection timeouts per player slot."
        },
        "disconnect_timeout": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 16,
          "minItems": 1,
          "description": "One count of reconnect timeouts per player slot."
        },
        "mean_tasks_per_seat": {
          "type": "number",
          "minimum": 0,
          "description": "Mean completed-task count across all seats this episode (sum of seat tasks / seat count)."
        },
        "any_seat_voted_or_no_meeting": {
          "type": "boolean",
          "description": "True if any seat cast a deliberate vote or skip this episode, or if no meeting occurred (no vote opportunity). Self-play: any seat is the submitted policy."
        },
        "mean_kills_per_imposter_seat": {
          "type": "number",
          "minimum": 0,
          "description": "Mean kill count across seats that were imposter this episode (sum of imposter-seat kills / number of imposter seats). 0 if none."
        }
      },
      "additionalProperties": false
    },
